# Copy to .env (never commit .env). Only needed for Live mode; Replay works without it.
# Provider: gemini, anthropic (Claude API directly), or openrouter
AGENTGATE_PROVIDER=gemini
# If your shell already exports GOOGLE_API_KEY, no key is needed in this file.
# GOOGLE_API_KEY=your-key-here
# GEMINI_API_KEY is also accepted; GOOGLE_API_KEY takes precedence when both exist.
# For anthropic, set ANTHROPIC_API_KEY instead.
# ANTHROPIC_API_KEY=your-key-here
# For openrouter, set OPENROUTER_API_KEY instead; the default model is then anthropic/claude-haiku-4.5
# OPENROUTER_API_KEY=your-key-here
# Optional settings
# Leave unset to use the selected provider's default model.
# AGENTGATE_MODEL=gemini-3.5-flash-lite
# Effort applies to the anthropic provider only
AGENTGATE_EFFORT=medium
AGENTGATE_TIMEOUT=45
# 1 = server-side refusal fallback on the Claude API; set 0 if your account rejects it
AGENTGATE_FALLBACKS=1
